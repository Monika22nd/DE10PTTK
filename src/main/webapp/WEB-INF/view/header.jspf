<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="vi_VN" scope="page"/>
<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Siêu thị trực tuyến 6 · Đề 10</title>
  <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/styles.css">
  <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/theme.css">
</head>
<body>
<header class="topbar">
  <div class="shell topbar-inner">
    <a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">S</span><span>Siêu thị trực tuyến <small>Đề 10 · B23DCDT076</small></span></a>
    <nav aria-label="Điều hướng chính">
      <a href="${pageContext.request.contextPath}/">Trang chủ</a>
      <a href="${pageContext.request.contextPath}/register">Đăng ký thành viên</a>
      <c:if test="${sessionScope.user.role eq 'MANAGEMENT_STAFF'}"><a href="${pageContext.request.contextPath}/manager">Trang quản lý</a></c:if>
      <c:choose>
        <c:when test="${not empty sessionScope.user}">
          <span class="signed-in"><c:out value="${sessionScope.user.fullName}"/></span>
          <form class="inline" method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="csrf" value="${csrf}"><button class="text-button" type="submit">Đăng xuất</button></form>
        </c:when>
        <c:otherwise><a href="${pageContext.request.contextPath}/login">Đăng nhập</a></c:otherwise>
      </c:choose>
    </nav>
  </div>
</header>
<main class="shell page">
