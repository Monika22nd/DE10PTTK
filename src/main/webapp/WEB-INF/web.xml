<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
  <display-name>Supermarket Modules 6</display-name>
  <listener><listener-class>com.example.supermarket.AppListener</listener-class></listener>
  <session-config><cookie-config><http-only>true</http-only></cookie-config><tracking-mode>COOKIE</tracking-mode></session-config>
  <servlet><servlet-name>home</servlet-name><servlet-class>com.example.supermarket.HomeServlet</servlet-class></servlet>
  <servlet><servlet-name>register</servlet-name><servlet-class>com.example.supermarket.RegisterServlet</servlet-class></servlet>
  <servlet><servlet-name>registerSuccess</servlet-name><servlet-class>com.example.supermarket.RegisterSuccessServlet</servlet-class></servlet>
  <servlet><servlet-name>login</servlet-name><servlet-class>com.example.supermarket.LoginServlet</servlet-class></servlet>
  <servlet><servlet-name>logout</servlet-name><servlet-class>com.example.supermarket.LogoutServlet</servlet-class></servlet>
  <servlet><servlet-name>reports</servlet-name><servlet-class>com.example.supermarket.ReportsServlet</servlet-class></servlet>
  <servlet><servlet-name>itemStats</servlet-name><servlet-class>com.example.supermarket.ItemStatisticsServlet</servlet-class></servlet>
  <servlet><servlet-name>itemDetail</servlet-name><servlet-class>com.example.supermarket.ItemDetailServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>home</servlet-name><url-pattern>/home</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>register</servlet-name><url-pattern>/register</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>registerSuccess</servlet-name><url-pattern>/register/success</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>login</servlet-name><url-pattern>/login</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>logout</servlet-name><url-pattern>/logout</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>reports</servlet-name><url-pattern>/reports</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>itemStats</servlet-name><url-pattern>/reports/items</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>itemDetail</servlet-name><url-pattern>/reports/items/detail</url-pattern></servlet-mapping>
</web-app>
