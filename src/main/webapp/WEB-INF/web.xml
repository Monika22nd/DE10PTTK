<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
  <display-name>Online Supermarket 6 - De 10 - B23DCDT076</display-name>
  <listener><listener-class>controller.AppContextListener6</listener-class></listener>
  <session-config><cookie-config><http-only>true</http-only></cookie-config><tracking-mode>COOKIE</tracking-mode></session-config>
  <welcome-file-list><welcome-file>index.jsp</welcome-file></welcome-file-list>

  <servlet><servlet-name>home</servlet-name><servlet-class>controller.HomeServlet6</servlet-class></servlet>
  <servlet><servlet-name>login</servlet-name><servlet-class>controller.LoginServlet6</servlet-class></servlet>
  <servlet><servlet-name>logout</servlet-name><servlet-class>controller.LogoutServlet6</servlet-class></servlet>
  <servlet><servlet-name>register</servlet-name><servlet-class>controller.MemberRegistrationServlet6</servlet-class></servlet>
  <servlet><servlet-name>manager</servlet-name><servlet-class>controller.ManagerHomeServlet6</servlet-class></servlet>
  <servlet><servlet-name>itemStatistics</servlet-name><servlet-class>controller.ItemStatisticsServlet6</servlet-class></servlet>

  <servlet-mapping><servlet-name>home</servlet-name><url-pattern>/home</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>login</servlet-name><url-pattern>/login</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>logout</servlet-name><url-pattern>/logout</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>register</servlet-name><url-pattern>/register</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>register</servlet-name><url-pattern>/register/success</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>manager</servlet-name><url-pattern>/manager</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>manager</servlet-name><url-pattern>/reports</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>itemStatistics</servlet-name><url-pattern>/reports/items</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>itemStatistics</servlet-name><url-pattern>/reports/items/detail</url-pattern></servlet-mapping>
</web-app>
